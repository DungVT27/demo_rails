<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Demo Rails - Store Booking Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Demo Rails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Primary stylesheet and importmaps -->
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Floating Flash Alerts Container -->
    <div class="floating-alerts-container">
      <% flash.each do |type, message| %>
        <%# Map devise and standard flash types to Bootstrap/Custom types %>
        <% alert_class = case type.to_s
                         when 'notice' then 'notice'
                         when 'alert' then 'alert'
                         when 'success' then 'success'
                         when 'warning' then 'warning'
                         else 'info'
                         end %>
        <div class="premium-alert premium-alert-<%= alert_class %> alert alert-dismissible fade show" role="alert">
          <div class="d-flex align-items-center gap-2">
            <% case alert_class
               when 'success' %><i class="bi bi-check-circle-fill"></i>
            <% when 'alert' %><i class="bi bi-exclamation-triangle-fill"></i>
            <% when 'warning' %><i class="bi bi-exclamation-circle-fill"></i>
            <% else %><i class="bi bi-info-circle-fill"></i>
            <% end %>
            <span><%= message %></span>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>

    <% if user_signed_in? %>
      <!-- Logged-in Dashboard Shell Layout -->
      <div class="app-container">
        <!-- Sticky Sidebar -->
        <aside class="sidebar">
          <a href="<%= root_path %>" class="brand">
            <i class="bi bi-calendar2-check-fill text-primary"></i>
            <span>Demo Rails</span>
          </a>

          <ul class="sidebar-menu">
            <% unless current_user.admin? %>
              <li>
                <a href="<%= stores_path %>" class="sidebar-link <%= 'active' if current_page?(stores_path) || current_page?(root_path) %>">
                  <i class="bi bi-shop"></i>
                  <span>Browse Stores</span>
                </a>
              </li>
              <li>
                <a href="<%= bookings_path %>" class="sidebar-link <%= 'active' if current_page?(bookings_path) %>">
                  <i class="bi bi-calendar-event"></i>
                  <span>My Bookings</span>
                </a>
              </li>
            <% end %>

            <% if current_user.admin? %>
              <li>
                <a href="<%= admin_dashboard_path %>" class="sidebar-link <%= 'active' if current_page?(admin_dashboard_path) %>">
                  <i class="bi bi-speedometer2"></i>
                  <span>Dashboard</span>
                </a>
              </li>
              <li>
                <a href="<%= admin_stores_path %>" class="sidebar-link <%= 'active' if controller_path.start_with?('admin/stores') %>">
                  <i class="bi bi-gear-fill"></i>
                  <span>Manage Stores</span>
                </a>
              </li>
              <li>
                <a href="<%= admin_users_path %>" class="sidebar-link <%= 'active' if controller_path.start_with?('admin/users') %>">
                  <i class="bi bi-people-fill"></i>
                  <span>Manage Users</span>
                </a>
              </li>
              <li>
                <a href="<%= admin_bookings_path %>" class="sidebar-link <%= 'active' if controller_path.start_with?('admin/bookings') %>">
                  <i class="bi bi-journal-bookmark-fill"></i>
                  <span>Manage Bookings</span>
                </a>
              </li>
            <% end %>
          </ul>

          <div class="sidebar-footer">
            <!-- User Quick Card -->
            <div class="d-flex align-items-center gap-3 p-2 bg-dark rounded-3" style="--bs-bg-opacity: 0.3;">
              <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-weight: 700;">
                <%= current_user.name.first.upcase %>
              </div>
              <div class="overflow-hidden" style="flex-grow: 1;">
                <div class="text-truncate fw-semibold text-white" style="font-size: 14px;"><%= current_user.name %></div>
                <div class="text-truncate" style="font-size: 12px; color: #cbd5e1 !important;"><%= current_user.email %></div>
              </div>
              <span class="badge text-bg-<%= current_user.admin? ? 'danger' : 'primary' %> text-uppercase" style="font-size: 9px;"><%= current_user.role %></span>
            </div>
            
            <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-outline-danger w-100 py-2 d-flex align-items-center justify-content-center gap-2", data: { turbo: false } do %>
              <i class="bi bi-box-arrow-right"></i>
              <span>Logout</span>
            <% end %>
          </div>
        </aside>

        <!-- Main Dashboard View Panel -->
        <main class="main-content">
          <!-- Top Sticky Navbar -->
          <div class="top-navbar">
            <div>
              <h4 class="mb-0 fw-semibold text-dark"><%= content_for(:title) || "Welcome to Demo Rails" %></h4>
              <p class="text-muted mb-0 font-size-sm" style="font-size: 13px;">Manage stores, verify schedules, and complete check-outs.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
              <span class="text-muted d-none d-md-inline" style="font-size: 13px;">
                <i class="bi bi-clock-fill text-primary"></i> <%= Time.current.strftime("%A, %b %d") %>
              </span>
              <span class="badge bg-secondary text-uppercase"><%= current_user.role %></span>
            </div>
          </div>

          <%= yield %>
        </main>
      </div>
    <% else %>
      <!-- Unauthenticated Public / Registration Layout -->
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 shadow">
        <div class="container">
          <a class="navbar-brand fw-extrabold fs-4 d-flex align-items-center gap-2" href="<%= root_path %>">
            <i class="bi bi-calendar2-check-fill text-primary"></i>
            <span>Demo Rails</span>
          </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
            <span class="navbar-toggler-icon"></span>
          </button>
          
          <div class="collapse navbar-collapse" id="publicNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <a class="nav-link fw-medium" href="<%= stores_path %>"><i class="bi bi-shop me-1"></i> Stores</a>
              </li>
            </ul>
            <div class="d-flex gap-2">
              <a href="<%= new_user_session_path %>" class="btn btn-outline-light px-4 fw-semibold"><i class="bi bi-box-arrow-in-right me-1"></i> Sign In</a>
              <a href="<%= new_user_registration_path %>" class="btn btn-primary px-4 fw-semibold"><i class="bi bi-person-plus-fill me-1"></i> Register</a>
            </div>
          </div>
        </div>
      </nav>

      <div class="container py-5">
        <%= yield %>
      </div>
    <% end %>

    <!-- Global Bootstrap Delete Confirmation Modal -->
    <div class="modal fade" id="globalDeleteConfirmModal" tabindex="-1" aria-labelledby="globalDeleteConfirmModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
          <div class="modal-header border-0 bg-danger-subtle text-danger py-3">
            <h5 class="modal-title fw-bold" id="globalDeleteConfirmModalLabel">
              <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Action
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body py-4 text-center">
            <i class="bi bi-trash3-fill text-danger display-4 mb-3 d-block"></i>
            <h4 class="fw-bold text-dark mb-2" id="global-modal-title">Are you sure?</h4>
            <p class="text-muted mb-0 px-3" id="global-modal-body">
              Are you sure you want to perform this action? This step is irreversible.
            </p>
          </div>
          <div class="modal-footer border-0 bg-light d-flex gap-2 justify-content-center py-3">
            <button type="button" class="btn btn-outline-secondary px-4 py-2 fw-semibold" data-bs-dismiss="modal" style="border-radius: 8px;">Cancel</button>
            <button type="button" id="confirm-global-delete-btn" class="btn btn-danger px-4 py-2 fw-bold" style="border-radius: 8px;">Confirm Delete</button>
          </div>
        </div>
      </div>
    </div>


  </body>
</html>
