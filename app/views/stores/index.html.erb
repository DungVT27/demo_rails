<% content_for :title, "Browse Stores" %>

<div class="row mb-4">
  <div class="col-12">
    <!-- Premium Search Card -->
    <div class="premium-card">
      <div class="premium-card-body bg-light">
        <%= search_form_for @q, url: stores_path, class: "row g-3 align-items-end" do |f| %>
          <div class="col-md-5 col-sm-12">
            <label class="form-label fw-semibold text-dark" style="font-size: 13px;"><i class="bi bi-search me-1"></i> Search by Name</label>
            <%= f.search_field :name_cont, class: "form-control premium-input w-100", placeholder: "e.g. Downtown Oasis" %>
          </div>
          <div class="col-md-5 col-sm-12">
            <label class="form-label fw-semibold text-dark" style="font-size: 13px;"><i class="bi bi-geo-alt-fill me-1"></i> Search by Address</label>
            <%= f.search_field :address_cont, class: "form-control premium-input w-100", placeholder: "e.g. Broadway Street" %>
          </div>
          <div class="col-md-2 col-sm-12 d-flex gap-2">
            <%= f.submit "Filter", class: "btn btn-premium w-100 justify-content-center py-2" %>
            <%= link_to "Clear", stores_path, class: "btn btn-outline-secondary w-50 py-2 d-flex align-items-center justify-content-center" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Stores Grid -->
<div class="row g-4">
  <% if @stores.any? %>
    <% @stores.each do |store| %>
      <div class="col-md-6 col-lg-4">
        <div class="premium-card h-100 d-flex flex-column">
          <!-- Card Header with Fee badge -->
          <div class="premium-card-header bg-transparent border-0 pb-0">
            <span class="badge bg-success-subtle text-success fs-6 fw-bold px-3 py-2 border border-success-subtle rounded-3">
              $<%= number_with_precision(store.booking_fee, precision: 2) %> <span style="font-size: 10px; font-weight: 500;">FEE</span>
            </span>
            <span class="status-badge active"><%= store.status %></span>
          </div>

          <div class="premium-card-body flex-grow-1 d-flex flex-column justify-content-between pt-2">
            <div>
              <h4 class="card-title text-dark fw-bold mb-2"><%= store.name %></h4>
              <p class="text-muted text-truncate-3" style="font-size: 14px; min-height: 60px;"><%= store.description %></p>
            </div>

            <div class="mt-3">
              <div class="d-flex align-items-center gap-2 mb-2 text-dark" style="font-size: 13.5px;">
                <i class="bi bi-clock text-primary"></i>
                <span>Operating Hours: <strong><%= store.opening_time.strftime("%I:%M %p") %> - <%= store.closing_time.strftime("%I:%M %p") %></strong></span>
              </div>
              <div class="d-flex align-items-center gap-2 mb-3 text-muted" style="font-size: 13.5px;">
                <i class="bi bi-geo-alt text-danger"></i>
                <span class="text-truncate" style="max-width: 250px;"><%= store.address %></span>
              </div>
            </div>
          </div>

          <div class="card-footer bg-light border-top-0 p-3 mt-auto">
            <%= link_to store_path(store), class: "btn btn-premium w-100 justify-content-center py-2.5 fw-semibold" do %>
              <span>View Details & Book</span>
              <i class="bi bi-arrow-right-short fs-5"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="col-12">
      <div class="premium-card text-center p-5">
        <i class="bi bi-shop-window text-muted display-1 mb-3"></i>
        <h3 class="fw-bold text-dark">No Stores Found</h3>
        <p class="text-muted">There are no stores fitting your criteria or currently registered in our database.</p>
        <div class="mt-4">
          <%= link_to "Show All Stores", stores_path, class: "btn btn-premium" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Kaminari Pagination -->
<% if @stores.total_pages > 1 %>
  <div class="pagination-container">
    <%= paginate @stores %>
  </div>
<% end %>
