<% content_for :title, "Store Details - #{@store.name}" %>

<div class="row g-3">
  <!-- Top: Store Information Details (Full Width & Highly Compact) -->
  <div class="col-12">
    <div class="premium-card">
      <div class="premium-card-body py-3 px-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
          <div class="d-flex align-items-center gap-3">
            <h2 class="fw-extrabold text-dark mb-0" style="font-size: 24px;"><%= @store.name %></h2>
            <span class="status-badge active py-1 px-2" style="font-size: 11px;"><%= @store.status.upcase %></span>
          </div>
          <span class="text-muted" style="font-size: 12px;">Created <%= time_ago_in_words(@store.created_at) %> ago</span>
        </div>
        
        <p class="text-muted mb-3" style="font-size: 13.5px; line-height: 1.5;"><%= @store.description %></p>

        <div class="row g-2 pt-2.5 border-top" style="border-top-color: #e2e8f0 !important;">
          <!-- Address -->
          <div class="col-lg-3 col-md-6 col-12 d-flex align-items-center gap-2">
            <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
              <i class="bi bi-geo-alt-fill" style="font-size: 14px;"></i>
            </div>
            <div class="text-truncate">
              <small class="text-muted d-block" style="font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Address</small>
              <span class="text-dark fw-semibold text-truncate d-block" style="font-size: 13px;" title="<%= @store.address %>"><%= @store.address %></span>
            </div>
          </div>

          <!-- Operating Hours -->
          <div class="col-lg-3 col-md-6 col-12 d-flex align-items-center gap-2">
            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
              <i class="bi bi-clock-fill" style="font-size: 14px;"></i>
            </div>
            <div>
              <small class="text-muted d-block" style="font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Hours</small>
              <span class="text-dark fw-semibold" style="font-size: 13px;">
                <%= @store.opening_time.strftime("%I:%M %p") %> - <%= @store.closing_time.strftime("%I:%M %p") %>
              </span>
            </div>
          </div>

          <!-- Booking Fee -->
          <div class="col-lg-3 col-md-6 col-12 d-flex align-items-center gap-2">
            <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
              <i class="bi bi-currency-dollar" style="font-size: 14px;"></i>
            </div>
            <div>
              <small class="text-muted d-block" style="font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Fee</small>
              <span class="text-dark fw-bold" style="font-size: 13px;">$<%= number_with_precision(@store.booking_fee, precision: 2) %></span>
            </div>
          </div>

          <!-- Support / Guarantee -->
          <div class="col-lg-3 col-md-6 col-12 d-flex align-items-center gap-2">
            <div class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
              <i class="bi bi-shield-check" style="font-size: 14px;"></i>
            </div>
            <div>
              <small class="text-muted d-block" style="font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Guaranteed</small>
              <span class="text-dark fw-semibold" style="font-size: 13px;">Staff Prioritized</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom: Booking Scheduler Panel (Horizontal Bar Widget) -->
  <div class="col-12">
    <% if user_signed_in? %>
      <div class="premium-card">
        <div class="premium-card-body p-4">
          <h4 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2" style="font-size: 18px;">
            <i class="bi bi-calendar-check-fill text-primary"></i> Book Appointment
          </h4>
          
          <%= form_with(model: @booking, local: true, html: { novalidate: true }, class: "d-flex flex-column gap-3") do |f| %>
            <%= f.hidden_field :store_id %>

            <!-- Top Row: Date and Time Inputs -->
            <div class="row g-3">
              <!-- Booking Date Input -->
              <div class="col-md-6 col-12">
                <label class="form-label fw-semibold text-dark mb-1" style="font-size: 13px;"><i class="bi bi-calendar-event me-1"></i> Date</label>
                <%= f.date_field :booking_date, 
                                id: "booking_date_input", 
                                class: "form-control premium-input w-100", 
                                min: Date.current, 
                                style: "padding: 8px 12px; font-size: 14px;" %>
              </div>

              <!-- Booking Time Selector -->
              <div class="col-md-6 col-12">
                <label class="form-label fw-semibold text-dark mb-1" style="font-size: 13px;"><i class="bi bi-clock me-1"></i> Time Slot</label>
                <% 
                  # Generate 1-hour intervals from opening_time up to closing_time - 1.hour
                  time_slots = []
                  current_slot = @store.opening_time
                  while current_slot <= @store.closing_time - 1.hour
                    time_slots << current_slot.strftime("%H:%M")
                    current_slot += 1.hour
                  end
                %>
                <%= f.select :booking_time, 
                             options_for_select(time_slots.map { |t| [Time.zone.parse("2000-01-01 #{t}").strftime("%I:%M %p"), t] }, @booking.booking_time&.strftime("%H:%M")),
                             { include_blank: "Select a time slot..." }, 
                             id: "booking_time_select",
                             class: "form-select premium-input w-100", 
                             style: "padding: 8px 12px; font-size: 14px;" %>
              </div>
            </div>

            <!-- Bottom Row: Price Summary & Action Button -->
            <div class="d-flex align-items-center justify-content-between p-3 mt-1 bg-light rounded-3 border border-light-subtle">
              <div class="d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; flex-shrink: 0;">
                  <i class="bi bi-currency-dollar fs-5"></i>
                </div>
                <div>
                  <small class="text-muted d-block" style="font-size: 9px; font-weight: 700; text-transform: uppercase;">Total Due</small>
                  <span class="fw-extrabold text-primary fs-4">$<%= number_with_precision(@store.booking_fee, precision: 2) %></span>
                </div>
              </div>
              <div>
                <%= f.submit "Schedule Appointment", class: "btn btn-premium py-2.5 px-4 justify-content-center fw-bold", style: "font-size: 14.5px; border-radius: 8px;" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>


    <% else %>
      <!-- Unauthenticated Sign-in Request Panel -->
      <div class="premium-card py-3 px-4">
        <div class="premium-card-body d-flex flex-wrap align-items-center justify-content-between gap-3 py-1">
          <div class="d-flex align-items-center gap-2 text-start">
            <i class="bi bi-lock-fill text-muted fs-3"></i>
            <div>
              <h5 class="fw-bold text-dark mb-0" style="font-size: 15px;">Sign in to Book Appointment</h5>
              <p class="text-muted mb-0" style="font-size: 12.5px;">A client account is required to schedule reservations at this store.</p>
            </div>
          </div>
          <div class="d-flex gap-2">
            <%= link_to new_user_session_path, class: "btn btn-premium py-2 px-4 justify-content-center fw-semibold", style: "font-size: 13.5px; height: 38px; display: inline-flex; align-items: center;" do %>
              <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            <% end %>
            <%= link_to new_user_registration_path, class: "btn btn-outline-secondary py-2 px-4 fw-semibold", style: "font-size: 13.5px; height: 38px; display: inline-flex; align-items: center;" do %>
              <i class="bi bi-person-plus-fill me-1"></i> Register
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
