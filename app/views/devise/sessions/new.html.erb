<% content_for :title, "Sign In to Demo Rails" %>

<div class="row">
  <div class="col-lg-5 col-md-7 col-sm-9 mx-auto col-12">
    <div class="premium-card shadow-lg border-0" style="border-radius: 16px; margin-top: 10px;">
      <div class="premium-card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-shield-lock-fill fs-2"></i>
          </div>
          <h3 class="fw-extrabold text-dark mb-1">Welcome Back</h3>
          <p class="text-muted" style="font-size: 14px;">Sign in to manage bookings and stores</p>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "d-flex flex-column gap-3", novalidate: true }) do |f| %>
          
          <!-- Email Input -->
          <div class="form-group">
            <%= f.label :email, "Email Address", class: "form-label fw-semibold text-dark mb-1", style: "font-size: 13.5px;" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: #cbd5e1; border-top-left-radius: 8px; border-bottom-left-radius: 8px;"><i class="bi bi-envelope"></i></span>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control premium-input border-start-0", placeholder: "yourname@example.com", style: "border-top-left-radius: 0; border-bottom-left-radius: 0; padding: 10px 14px; font-size: 14.5px;" %>
            </div>
          </div>

          <!-- Password Input -->
          <div class="form-group">
            <%= f.label :password, "Password", class: "form-label fw-semibold text-dark mb-1", style: "font-size: 13.5px;" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: #cbd5e1; border-top-left-radius: 8px; border-bottom-left-radius: 8px;"><i class="bi bi-lock"></i></span>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control premium-input border-start-0", placeholder: "••••••••", style: "border-top-left-radius: 0; border-bottom-left-radius: 0; padding: 10px 14px; font-size: 14.5px;" %>
            </div>
          </div>

          <!-- Remember Me Checkbox -->
          <% if devise_mapping.rememberable? %>
            <div class="form-check d-flex align-items-center gap-2 my-1">
              <%= f.check_box :remember_me, class: "form-check-input", style: "cursor: pointer; width: 18px; height: 18px;" %>
              <%= f.label :remember_me, "Keep me signed in", class: "form-check-label text-muted fw-medium", style: "font-size: 13.5px; cursor: pointer; user-select: none;" %>
            </div>
          <% end %>

          <!-- Submit Button -->
          <div class="mt-2">
            <%= f.submit "Sign In", class: "btn btn-premium w-100 py-2.5 justify-content-center fw-bold fs-6", style: "border-radius: 8px; height: 46px;" %>
          </div>
        <% end %>

        <hr class="my-4" style="border-color: #e2e8f0;">

        <div class="text-center">
          <p class="text-muted mb-0" style="font-size: 14px;">
            Don't have an account? 
            <%= link_to "Register now", new_registration_path(resource_name), class: "text-primary fw-bold text-decoration-none" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
