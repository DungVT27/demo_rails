<% content_for :title, "Create a Demo Rails Account" %>

<div class="row">
  <div class="col-lg-5 col-md-7 col-sm-9 mx-auto col-12">
    <div class="premium-card shadow-lg border-0" style="border-radius: 16px; margin-top: 10px;">
      <div class="premium-card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-person-plus-fill fs-2"></i>
          </div>
          <h3 class="fw-extrabold text-dark mb-1">Get Started</h3>
          <p class="text-muted" style="font-size: 14px;">Create your client account in just seconds</p>
        </div>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "d-flex flex-column gap-3", novalidate: true }) do |f| %>
          
          <!-- Render Devise validation errors beautifully if present -->
          <% if resource.errors.any? %>
            <div class="alert alert-danger border-0 p-3" style="border-radius: 8px; font-size: 13.5px;">
              <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-1"></i> Please fix the following errors:</h6>
              <ul class="mb-0 ps-3">
                <% resource.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- Name Input -->
          <div class="form-group">
            <%= f.label :name, "Full Name", class: "form-label fw-semibold text-dark mb-1", style: "font-size: 13.5px;" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: #cbd5e1; border-top-left-radius: 8px; border-bottom-left-radius: 8px;"><i class="bi bi-person"></i></span>
              <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "form-control premium-input border-start-0", placeholder: "e.g. John Doe", style: "border-top-left-radius: 0; border-bottom-left-radius: 0; padding: 10px 14px; font-size: 14.5px;" %>
            </div>
          </div>

          <!-- Email Input -->
          <div class="form-group">
            <%= f.label :email, "Email Address", class: "form-label fw-semibold text-dark mb-1", style: "font-size: 13.5px;" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: #cbd5e1; border-top-left-radius: 8px; border-bottom-left-radius: 8px;"><i class="bi bi-envelope"></i></span>
              <%= f.email_field :email, autocomplete: "email", class: "form-control premium-input border-start-0", placeholder: "yourname@example.com", style: "border-top-left-radius: 0; border-bottom-left-radius: 0; padding: 10px 14px; font-size: 14.5px;" %>
            </div>
          </div>

          <!-- Password Input -->
          <div class="form-group">
            <%= f.label :password, "Password", class: "form-label fw-semibold text-dark mb-1", style: "font-size: 13.5px;" %>
            <% if @minimum_password_length %>
              <small class="text-muted fw-normal d-block mb-1" style="font-size: 11px;">(<%= @minimum_password_length %> characters minimum)</small>
            <% end %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: #cbd5e1; border-top-left-radius: 8px; border-bottom-left-radius: 8px;"><i class="bi bi-lock"></i></span>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control premium-input border-start-0", placeholder: "••••••••", style: "border-top-left-radius: 0; border-bottom-left-radius: 0; padding: 10px 14px; font-size: 14.5px;" %>
            </div>
          </div>

          <!-- Password Confirmation Input -->
          <div class="form-group">
            <%= f.label :password_confirmation, "Confirm Password", class: "form-label fw-semibold text-dark mb-1", style: "font-size: 13.5px;" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: #cbd5e1; border-top-left-radius: 8px; border-bottom-left-radius: 8px;"><i class="bi bi-shield-check"></i></span>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control premium-input border-start-0", placeholder: "••••••••", style: "border-top-left-radius: 0; border-bottom-left-radius: 0; padding: 10px 14px; font-size: 14.5px;" %>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="mt-2">
            <%= f.submit "Create Account", class: "btn btn-premium w-100 py-2.5 justify-content-center fw-bold fs-6", style: "border-radius: 8px; height: 46px;" %>
          </div>
        <% end %>

        <hr class="my-4" style="border-color: #e2e8f0;">

        <div class="text-center">
          <p class="text-muted mb-0" style="font-size: 14px;">
            Already have an account? 
            <%= link_to "Sign in instead", new_session_path(resource_name), class: "text-primary fw-bold text-decoration-none" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
