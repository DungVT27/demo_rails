<% content_for :title, "Store Details - #{@store.name}" %>

<div class="mb-4 d-flex justify-content-between align-items-center">
  <%= link_to admin_stores_path, class: "btn btn-outline-secondary" do %>
    <i class="bi bi-arrow-left me-1"></i> Back to Stores
  <% end %>
  <div class="d-flex gap-2">
    <%= link_to edit_admin_store_path(@store), class: "btn btn-outline-warning" do %>
      <i class="bi bi-pencil me-1"></i> Edit
    <% end %>
    <button type="button" 
            class="btn btn-premium-danger btn-delete-trigger" 
            data-url="<%= admin_store_path(@store) %>" 
            data-method="delete" 
            data-message="Are you sure you want to delete store '<%= @store.name %>'?">
      <i class="bi bi-trash me-1"></i> Delete Store
    </button>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6 col-md-12">
    <div class="premium-card h-100">
      <div class="premium-card-header bg-transparent border-bottom-0 pb-0">
        <h5 class="fw-bold text-dark mb-0">Store Details</h5>
      </div>
      <div class="premium-card-body">
        <h2 class="fw-extrabold text-dark mb-3"><%= @store.name %></h2>
        <p class="text-muted mb-4"><%= @store.description %></p>
        
        <table class="table table-borderless">
          <tr>
            <td class="text-muted fw-semibold py-2" style="width: 35%;">Address:</td>
            <td class="text-dark fw-medium py-2"><%= @store.address %></td>
          </tr>
          <tr>
            <td class="text-muted fw-semibold py-2">Opening Time:</td>
            <td class="text-dark fw-medium py-2"><%= @store.opening_time.strftime("%I:%M %p") %></td>
          </tr>
          <tr>
            <td class="text-muted fw-semibold py-2">Closing Time:</td>
            <td class="text-dark fw-medium py-2"><%= @store.closing_time.strftime("%I:%M %p") %></td>
          </tr>
          <tr>
            <td class="text-muted fw-semibold py-2">Booking Fee:</td>
            <td class="text-dark fw-bold py-2">$<%= number_with_precision(@store.booking_fee, precision: 2) %></td>
          </tr>
          <tr>
            <td class="text-muted fw-semibold py-2">Status:</td>
            <td class="py-2"><span class="status-badge <%= @store.status %>"><%= @store.status.upcase %></span></td>
          </tr>
        </table>
      </div>
    </div>
  </div>

  <!-- Real-time associated bookings statistics -->
  <div class="col-lg-6 col-md-12">
    <div class="premium-card h-100">
      <div class="premium-card-header bg-transparent border-bottom-0 pb-0">
        <h5 class="fw-bold text-dark mb-0">Bookings Statistics</h5>
      </div>
      <div class="premium-card-body">
        <div class="row text-center g-3 mb-4">
          <div class="col-6 col-md-3">
            <span class="text-muted d-block" style="font-size: 12px;">Total</span>
            <h3 class="fw-extrabold text-dark mb-0"><%= @store.bookings.count %></h3>
          </div>
          <div class="col-6 col-md-3">
            <span class="text-muted d-block" style="font-size: 12px;">Approved</span>
            <h3 class="fw-extrabold text-success mb-0"><%= @store.bookings.approved.count %></h3>
          </div>
          <div class="col-6 col-md-3">
            <span class="text-muted d-block" style="font-size: 12px;">Cancelled</span>
            <h3 class="fw-extrabold text-danger mb-0"><%= @store.bookings.cancelled.count %></h3>
          </div>
          <div class="col-6 col-md-3">
            <span class="text-muted d-block" style="font-size: 12px;">Completed</span>
            <h3 class="fw-extrabold text-primary mb-0"><%= @store.bookings.completed.count %></h3>
          </div>
        </div>

        <h6 class="fw-bold text-dark mb-2">Estimated Revenue generated:</h6>
        <% store_revenue = @store.bookings.where(status: [:approved, :completed]).count * @store.booking_fee %>
        <h2 class="fw-extrabold text-success mb-0">$<%= number_with_precision(store_revenue, precision: 2) %></h2>
        <small class="text-muted">Calculated from approved and completed bookings.</small>
      </div>
    </div>
  </div>
</div>
