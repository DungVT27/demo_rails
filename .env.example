APP_NAME=demo_rails
PORT=3000
APP_LEVEL=local

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=demo_rails

# Mail
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME="${APP_NAME}"

# Redis Configuration
REDIS_URL=redis://:secret_redis@127.0.0.1:6379/1

# Localization Configuration
DEFAULT_LOCALE=en
